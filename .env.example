# Unified local development configuration
PORT=8787
VITE_PORT=5173
CORS_ORIGIN=http://127.0.0.1:5173
AXIE_ECHELON_API_KEY=your_actual_key_here
DEBUG_ON=false

# Select one profile when starting a single tracker:
#   set TRACKER_PROFILE=2 && npm run dev
#   $env:TRACKER_PROFILE = "2"; npm run dev
#   TRACKER_PROFILE=2 npm run dev
#
# The selected profile is read once at startup and stays fixed for that process.
#
# Optional profiles for additional tracker instances:
# Profile 2 is the second tracker, profile 3 is the third tracker, and so on.
# There is no five-profile limit. Add profile 6 or higher by continuing the same
# numbered variable pattern. Each profile needs its own API key and configuration.
# The current convenience launcher has five predefined scripts:
#   start-tracker1.ps1 -> TRACKER_PROFILE=1
#   start-tracker2.ps1 -> TRACKER_PROFILE=2
#   start-tracker3.ps1 -> TRACKER_PROFILE=3
#   start-tracker4.ps1 -> TRACKER_PROFILE=4
#   start-tracker5.ps1 -> TRACKER_PROFILE=5
# Additional profiles can be started manually with TRACKER_PROFILE in a separate
# terminal, or by adding another start-trackerN.ps1 script.
#
# Profile-specific overrides:
# TRACKER_PROFILE_2_MAVIS_API_KEY=your_second_api_key_here
# TRACKER_PROFILE_2_VITE_LEADERBOARD_LIMIT=50
# TRACKER_PROFILE_2_VITE_LEADERBOARD_OFFSET=0
# TRACKER_PROFILE_2_VITE_POLLING_INTERVAL=30
# TRACKER_PROFILE_2_DEBUG_ON=false
#
# For every indexed profile (2, 3, 4, ...), the app derives PORT, VITE_PORT, and
# CORS_ORIGIN from the profile number. Add those variables only when a profile
# needs a custom value. Profile numbers must be contiguous; resolution stops at
# the first missing profile number.

# Temporary fixed leaderboard window until Phase 2 pagination is integrated
VITE_LEADERBOARD_LIMIT=50
VITE_LEADERBOARD_OFFSET=0
VITE_POLLING_INTERVAL=30