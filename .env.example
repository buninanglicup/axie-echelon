# Unified local development configuration
PORT=8787
VITE_PORT=5173
CORS_ORIGIN=http://127.0.0.1:5173
AXIE_ECHELON_API_KEY=your_actual_key_here
DEBUG_ON=false

# Profile selection for a single run:
#   set TRACKER_PROFILE=2 && npm run dev
#   $env:TRACKER_PROFILE = "2"; npm run dev
#   TRACKER_PROFILE=2 npm run dev
#
# The selected profile is read once at startup and stays fixed for that process.
# To add a second tracker, copy the pattern below and set the values you need.
# TRACKER_PROFILE_2_MAVIS_API_KEY=your_second_api_key_here
# TRACKER_PROFILE_2_VITE_LEADERBOARD_LIMIT=50
# TRACKER_PROFILE_2_VITE_LEADERBOARD_OFFSET=0
# TRACKER_PROFILE_2_VITE_POLLING_INTERVAL=30
# TRACKER_PROFILE_2_DEBUG_ON=false
#
# For profile 2+, the app auto-generates PORT / VITE_PORT / CORS_ORIGIN from the
# profile index, so you do not need to repeat them unless you want a custom override.

# Temporary fixed leaderboard window until Phase 2 pagination is integrated
VITE_LEADERBOARD_LIMIT=50
VITE_LEADERBOARD_OFFSET=0
VITE_POLLING_INTERVAL=30